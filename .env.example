# Copy to .env.local and fill in. Never commit real values.
MONGODB_URI=
JWT_SECRET=
NEXTAUTH_SECRET=
NEXT_PUBLIC_BASE_API_URL=http://localhost:3000

# Gmail account + app password used to send password-reset codes
NODEMAILER_EMAIL=
NODEMAILER_PASS=

# Firebase web app configuration (Storage is used for post images)
NEXT_PUBLIC_APIKEY=
NEXT_PUBLIC_AUTHDOMAIN=
NEXT_PUBLIC_PROJECTID=
NEXT_PUBLIC_STORAGEBUCKET=
NEXT_PUBLIC_MESSAGINSENDERID=
NEXT_PUBLIC_APPID=
NEXT_PUBLIC_MEASUREMENTID=
